#####################################################################
#   Fan Control
#####################################################################

# ##  Print Cooling Fan - FAN0
# [fan]
# pin: EBBCan:PD3
# kick_start_time: 0.5
# ##  Depending on your fan, you may need to increase this value
# ##  if your fan will not start. Can change cycle_time (increase)
# ##  if your fan is not able to slow down effectively
# off_below: 0.10


# ##  Print Cooling Fan - FAN1
# [fan]
# pin: EBBCan:PD5
# kick_start_time: 0.5
# ##  Depending on your fan, you may need to increase this value
# ##  if your fan will not start. Can change cycle_time (increase)
# ##  if your fan is not able to slow down effectively
# off_below: 0.10


# ##  Hotend Fan - FAN2
# [heater_fan hotend_fan]
# pin: EBBCan:PD2
# tachometer_pin: EBBCan:PA4
# max_power: 1.0
# kick_start_time: 0.5
# heater: extruder
# heater_temp: 50.0
# ##  If you are experiencing back flow, you can reduce fan_speed
# #fan_speed: 1.0

# ##  Controller fan - FAN2
# [controller_fan controller_fans]
# pin: PD12
# kick_start_time: 0.5
# heater: heater_bed

# [fan_generic bed_fan_l]
# pin: PE5
# kick_start_time: 0.5
# max_power: 1
# ##  Depending on your fan, you may need to increase this value
# ##  if your fan will not start. Can change cycle_time (increase)
# ##  if your fan is not able to slow down effectively
# off_below: 0.10

# [fan_generic bed_fan_r]
# pin: PD13
# kick_start_time: 0.5
# max_power: 1
# ##  Depending on your fan, you may need to increase this value
# ##  if your fan will not start. Can change cycle_time (increase)
# ##  if your fan is not able to slow down effectively
# off_below: 0.10


[fan_generic fantest1] #SSR
pin: PA8
kick_start_time: 0.5
max_power: 1
off_below: 0.10

[fan_generic fantest2] #Electronics Fan Right
pin: PE5
kick_start_time: 0.5
max_power: 1
off_below: 0.10

[fan_generic fantest3] #Electronics Fan Left
pin: PD12
kick_start_time: 0.5
max_power: 1
off_below: 0.10

[fan_generic fantest4] #Bed Fan Left
pin: PD13
kick_start_time: 0.5
max_power: 1
off_below: 0.10

[fan_generic fantest5] #Neevermore
pin: PD14
kick_start_time: 0.5
max_power: 1
off_below: 0.10

[fan_generic fantest6] #Bed Fan Right
pin: PD15
kick_start_time: 0.5
max_power: 1
off_below: 0.10








