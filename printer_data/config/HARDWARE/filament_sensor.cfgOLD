[filament_switch_sensor filament_sensor]
switch_pin: EBBCan:PD0
pause_on_runout: True
runout_gcode:
    PAUSE
    M117 Filament had runout!!!
insert_gcode:
    {% if printer.idle_timeout.state != "Printing" %}
        LOAD_FILAMENT
    {% else %}
        M118 Code should be here for insert while not printing
    {% endif %}
event_delay: 3.0
pause_delay: 0.5

[gcode_macro LOAD_FILAMENT]
gcode:
    {% set globals = printer['gcode_macro _GLOBALS'] %} ; get global variables
    {% set LOAD_TEMP = params.TEMP|default(globals.auto_load_temperature)|int %}
    {% set MIN_TEMP = params.MIN_TEMP|default(globals.auto_load_min_temp)|int %}
    {% set LOAD_EXTR_TO_NOZ = params.EXTRUDER_DIST|default(globals.auto_load_extruder_to_nozzle)|int %}
    {% set LOAD_EXTRA_DIST = params.EXTRA_DIST|default(globals.auto_load_extra_dist)|int %}
    {% set LOAD_SPD = params.SPEED|default(globals.auto_load_spd)|int %}
    {% set TOTAL_DIST = (LOAD_EXTR_TO_NOZ+LOAD_EXTRA_DIST) %}
    {% set PREVIOUS_TEMP = printer.extruder.target %} # save previous temperature for returning to it
    
    SAVE_GCODE_STATE NAME=loading_state
    
    {% if (printer.extruder.can_extrude|lower != 'true') or (printer.extruder.target < MIN_TEMP) %} # checking for minimum extrusion temperature
        M118 Previous target temperature ({PREVIOUS_TEMP}) too low. Heating for loading!
        SET_HEATER_TEMPERATURE HEATER=extruder TARGET={LOAD_TEMP} # set user defined load temperature
    {% endif %}
    ABSOLUTE        #set extruder to absolute mode
    G92 E0
    G4 P1500        # wait for 1.5 seconds
    M117 Gripping filament!
    FORCE_MOVE STEPPER=extruder DISTANCE=15 VELOCITY=10 ACCEL=1000  # load filament inside the gears force move needs to be enabled    

    {% if printer.toolhead.homed_axes == "xyz" %}
        M118 Printer homed. No need to now.
    {% else %}
        M118 Homing printer for loading.
        G28
    {% endif %}
    RELATIVE
    G1 Z50 F240
    ABSOLUTE
    TEMPERATURE_WAIT SENSOR=extruder MINIMUM={LOAD_TEMP} # wait for reaching set temperature    
    M118 LOADING!
    G1 E{TOTAL_DIST} F{LOAD_SPD} # extrude preconfigured purge length
    M400 # wait to complete nozzle purge
    SET_HEATER_TEMPERATURE HEATER=extruder TARGET={PREVIOUS_TEMP} # restore user temp if it was set before loading
    M118 Filament load complete!   
    RESTORE_GCODE_STATE NAME=loading_state

    



[gcode_macro UNLOAD_FILAMENT]
gcode:
  {% set globals = printer['gcode_macro _GLOBALS'] %} ; get global variables
  {% set UNLOAD_TEMP = params.TEMP|default(globals.unload_temperature)|int %}
  {% set UNLOAD_DIST = params.TEMP|default(globals.unload_distance)|int %}
  {% set UNLOAD_SPEED = params.TEMP|default(globals.unload_speed)|int %}
  
  #{% if printer.idle_timeout.state == "printing" %}
  {% if printer.print_stats.state == "printing" %}
    M118 Pausing!
    PAUSE
  {% endif %}

  
  {% if (printer.extruder.can_extrude|lower != 'true') %} # checing for minimum extrusion temperature
        # check if temperature is over the minimum extrusion temp. min_extrude_temp must be defined in the extruder config (to about 185)
      M118 Hotend heating!        
      SET_HEATER_TEMPERATURE HEATER=extruder TARGET={UNLOAD_TEMP} # restore user temp if it was set before loading
      TEMPERATURE_WAIT SENSOR=extruder MINIMUM={UNLOAD_TEMP} #wait for reaching filament unload temp
      {% endif %}     
  {% if(printer.extruder.target == 0) %} # checing for set temperature if is zero than set to 200 / hotend hot but cooling due to set target temp 0
      M118 Not super sure why this one is here but it is!
      SET_HEATER_TEMPERATURE HEATER=extruder TARGET={UNLOAD_TEMP} # restore user temp if it was set before loading
      TEMPERATURE_WAIT SENSOR=extruder MINIMUM={UNLOAD_TEMP} #wait for reaching filament unload temp
  {% endif %} 
  RELATIVE
  M118 Unloading!
  G0 E-5 F3600 	#extract filament to cold end
  G4 P2000 # wait for two seconds
  G0 E10 F3600 # push the filament back 
  G0 E-10 F3600 	#extract filament to cold end
  G0 E-{UNLOAD_DIST} F300	# continue extraction slow allow filament to be cooled enough before reaches the gears  
  M400   
  M118 Unloading Finished!
  ABSOLUTE
  SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0 # swicth off heater
  

