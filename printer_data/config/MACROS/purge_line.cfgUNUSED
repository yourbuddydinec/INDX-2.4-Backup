################################
######### PURGE  LINE ##########
################################
[gcode_macro PURGE_LINE]
gcode:
    {% set globals = printer['gcode_macro _GLOBALS'] %} ; get global variables
    M118 INSERT PURGE LINE CODE HERE!!!!!!!



# {% set COOL_AFTER = params.COOL|default(False)|lower %}
# {% set COOL_AFTER = params.COOL|default(True)|lower %}
# {% if COOL_AFTER|lower == "true" %}
# {% if COOL_AFTER|lower == "false" %}













variable_primeline_x_start_pos: (18)
variable_primeline_y_start_pos: (1.0)
variable_primeline_z_start_pos: (0.2)

variable_primeline_x_move1_pos: (240)
variable_primeline_x_move1_e_dist: (15)
variable_primeline_y_move2_pos: (11)
variable_primeline_y_move2_e_dist: (0.700)
variable_primeline_x_move3_pos: (x move 1 dist minus 0.5 aka 239.5)
variable_primeline_x_move3_e_dist: (in one spot, 0.2)
variable_primeline_y_move4_pos: (y start pos + 0.5 aka 1.5)
variable_primeline_y_move4_e_dist: (0.700)
variable_primeline_x_move5_pos: (x start distance + 7 aka 25)
variable_primeline_x_move5_e_dist: (15)


variable_primeline_move_to_z_heght: 3
variable_primeline_move_to_speed: 18000
variable_primeline_initial_e_dist: 2
variable_primeline_initial_e_dist: 2




;===== nozzle load line ===============================
{% set globals = printer['gcode_macro _GLOBALS'] %} ; get global variables
ABSOLUTE
RELATIVE_E
G1 X{X START POS}(18) Y{Y START POS}(1.0) Z{Z MOVE POS 0.8} F{move speed}(18000) ; Move to start position
M109 S{nozzle_temperature_initial_layer[initial_extruder]}
G1 Z{Z PRIME START POS}(0.2)
G0 E{DONT MOVE BUT START POOPING AMOUNT}2 F300


G0 X{X PRIME END POS}(240) E{PRIME X EXTRUDE DISTANCE}(15) F{outer_wall_volumetric_speed/(0.3*0.5)     * 60}
G0 Y{Y PRIME END POS}(11) E{PRIME Y EXTRUDE DISTANCE)(0.700) F{outer_wall_volumetric_speed/(0.3*0.5)/ 4 * 60}
G0 X{X PRIME END POS-0.5mm}(239.5)
G0 E{PRIME FINAL POOP EXTRUDE DISTANCE IN PLACE}(0.2)
G0 Y1.5 E0.700 ; move back down making the last line thiccer
G0 X25 E15 F{outer_wall_volumetric_speed/(0.3*0.5)     * 60} ; print second line for long section
M400